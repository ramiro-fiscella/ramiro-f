<button id="themeToggle">
  <svg
    class="sun"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 480 480"
    aria-label="Icono de modo oscuro"
  >
    <g fill="currentColor">
      <circle cx="240" cy="240" r="240"></circle>
    </g>
  </svg>
  <svg
    class="moon"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 480 480"
    aria-label="Icono de modo claro"
  >
    <g fill="currentColor">
      <path
        d="M240 0a240 240 0 1 0 0 480 240 240 0 0 0 0-480Zm0 360a120 120 0 1 1 0-240 120 120 0 0 1 0 240Z"
      ></path>
    </g>
  </svg>
</button>

<style>
  button {
    padding: 0;
  }
  #themeToggle {
    border: none;
    background: none;
    cursor: pointer;
    /* Añadimos 'color' para que los SVG con 'fill="currentColor"' 
      hereden este color. Puedes cambiarlo por el que necesites.
    */
    color: #1427ff; /* Usando el color azul de tus SVGs originales */
  }

  /* Ajuste de tamaño y transición 
    Cambiamos 'img' por 'svg'
  */
  #themeToggle svg {
    width: 24px;
    height: 24px;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease,
      filter 0.3s ease;
  }

  /* Por defecto (modo claro): se muestra 'sun' y se oculta 'moon' */
  #themeToggle .sun {
    display: block;
  }
  #themeToggle .moon {
    display: none;
  }

  /* En modo oscuro: se oculta 'sun' y se muestra 'moon' */
  html.dark #themeToggle .sun {
    display: none;
  }
  html.dark #themeToggle .moon {
    display: block;
  }

  /* Hover effect
    Cambiamos 'img' por 'svg'
  */
  #themeToggle:hover svg {
    filter: drop-shadow(0 0 4px var(--color-primario));
  }
</style>

<script is:inline>
  // Determina el tema actual (localStorage, matchMedia o light por defecto)
  const theme = (() => {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
      return localStorage.getItem('theme');
    }
    if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
      return 'dark';
    }
    return 'light';
  })();

  if (theme === 'light') {
    document.documentElement.classList.remove('dark');
  } else {
    document.documentElement.classList.add('dark');
  }
  localStorage.setItem('theme', theme);

  const handleToggleClick = () => {
    const element = document.documentElement;
    element.classList.toggle('dark');
    const isDark = element.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  };

  document
    .getElementById('themeToggle')
    .addEventListener('click', handleToggleClick);
</script>
