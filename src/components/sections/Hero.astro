---
import { basics } from '@cv';
import Section from '@/components/Section.astro';
import WorldMap from '@/icons/WorldMap.astro';

const { name, label1, label2, location, profiles, email, resume } = basics;
const { city, region } = location;
---

<Section>
  <div class="container">
    <!-- <div class="info">
      <span class="location">
        <WorldMap />
        {city}, {region}
      </span>
    </div> -->

    <nav class="links">
      {
        resume && (
          <a
            class="resume"
            href={resume}
            title={`Descargar CV de ${name}`}
            target="_blank"
            rel="noopener noreferer"
          >
            Resume
          </a>
        )
      }
      {
        profiles.map(({ network, url }) => {
          return (
            <a
              class="social"
              href={url}
              title={`Visitar perfil de ${name} en ${network}`}
              target="_blank"
              rel="noopener noreferer"
            >
              {network}
            </a>
          );
        })
      }
    </nav>
  </div>
</Section>

<style>
  .container {
    /* LAYOUT: SIEMPRE EN COLUMNA
      Este es el layout principal y único.
    */
    display: flex;
    flex-direction: column;
    justify-content: center; /* Centrado verticalmente */
    align-items: flex-start; /* Todo a la izquierda */
    gap: 4rem; /* Espacio entre info y links */

    background-color: var(--color-fondo);
    padding: 15vh 0; /* Más aire para minimalismo */
    min-height: 70vh; /* Buena altura */
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 0.75rem; /* Espacio más ajustado entre títulos */
  }

  h1 {
    /* NO TAN BOLD: 
      Tamaño reducido, peso normal, sin mayúsculas.
    */
    font-size: clamp(2.5rem, 8vw, 4rem); /* Más pequeño que antes */
    font-weight: 700; /* Sigue siendo el nombre, pero no 800 */
    line-height: 1.1;
    color: var(--color-texto);
    letter-spacing: -0.01em;
  }

  h2 {
    /* NO TAN BOLD */
    font-size: clamp(1.1rem, 3vw, 1.4rem);
    font-weight: 500; /* Más ligero */
    line-height: 1.3;
    color: var(--color-primario);
    margin: 0;
  }

  .experience {
    font-size: 0.9em;
    font-weight: 400;
    color: var(--color-secundario);
    display: block;
    margin-top: 0.25rem;
  }

  .location {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-secundario);
    text-transform: uppercase; /* Mantenemos esto como único detalle "bold" */
    letter-spacing: 0.05em;
    font-size: 0.8rem; /* Más pequeño y sutil */
    font-weight: 500;
    margin-top: 0.5rem;
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: 1.25rem; /* Espaciado limpio */
    align-items: flex-start; /* Siempre a la izquierda */
  }

  .social,
  .resume {
    /* NO TAN BOLD: 
      Tamaño de fuente normal, peso 500, sin mayúsculas.
    */
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-texto);
    text-decoration: none;
    position: relative;
    padding-bottom: 4px;
    transition: color 0.3s var(--ease-out-quad);
  }

  .resume {
    color: var(--color-primario);
  }

  /* El hover minimalista se mantiene */
  .social::after,
  .resume::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--color-texto);
    transition: width 0.3s var(--ease-out-quad);
  }

  .resume::after {
    background-color: var(--color-primario);
  }

  .social:hover::after,
  .social:focus-visible::after,
  .resume:hover::after,
  .resume:focus-visible::after {
    width: 100%;
  }

  .social:hover,
  .social:focus-visible {
    color: var(--color-primario);
  }

  /* LAYOUT:
    No se necesita @media query. 
    El diseño es 100% fluido y consistente.
  */

  /* --- ANIMATIONS --- */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Animación escalonada */
  .info > * {
    opacity: 0;
    animation: fadeInUp 0.6s var(--ease-out-quad) forwards;
  }

  h1 {
    animation-delay: 0.2s;
  }
  h2 {
    animation-delay: 0.4s;
  }
  .location {
    animation-delay: 0.6s;
  }

  .links > a {
    opacity: 0;
    animation: fadeInUp 0.5s var(--ease-out-quad) forwards;
  }

  .links a:nth-child(1) {
    animation-delay: 0.8s;
  }
  .links a:nth-child(2) {
    animation-delay: 0.9s;
  }
  .links a:nth-child(3) {
    animation-delay: 1s;
  }
  .links a:nth-child(4) {
    animation-delay: 1.1s;
  }
</style>
