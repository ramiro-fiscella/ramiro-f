---
import Section from '../Section.astro';
import Skills from './Skills.astro';
---

<Section>
  <h2 class="subtitle">About</h2>

  <div class="about-container">
    <div class="about-text">
      <p>
        I've been designing since I was 16, starting with prints, flyers, and
        social media ads for local bands and business. Working in agile,
        international teams, I use tools like Figma, Adobe Suite, VSC, and
        Notion, and develop sites using mainly React (PERN stack) or Astro and
        Tailwind. I'm Argentine with European citizenship, which makes it easier
        to connect with teams worldwide.
      </p>
      <p class="motto">
        I love collaborating and creating digital experiences that make things
        easier for both users and clients.
      </p>
    </div>

    <Skills />
  </div>
</Section>

<style>
  /* --- Minimalismo y Mobile First --- */

  .about-container {
    /* MOBILE: Siempre en columna. Reducimos el gap para que todo esté más compacto */
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
    gap: 2rem;
  }

  /* El layout horizontal solo para pantallas grandes */
  @media (min-width: 768px) {
    .about-container {
      flex-direction: row;
      justify-content: space-evenly;
    }
  }

  .about-text {
    flex: 1;
    /* Mantenemos el max-width para desktop, pero en mobile no tendrá efecto */
    max-width: 60ch;
  }

  /* Párrafo principal */
  .main-text {
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    color: var(--color-texto);
    font-weight: 500;
  }

  /* El motto, más sutil y secundario */
  .motto {
    font-size: 0.95rem; /* Ligeramente más pequeño para más minimalismo */
    line-height: 1.5;
    color: var(--color-secundario);
    margin-bottom: 0;
    font-weight: 400;
  }

  .subtitle {
    margin-bottom: 2rem; /* Reducido de 3rem a 2rem para compactar */
  }

  /* Media query para restablecer tamaños en pantallas más grandes (desktop) */
  @media (min-width: 768px) {
    .main-text {
      font-size: 1.125rem; /* Volvemos al tamaño original en desktop */
      margin-bottom: 2rem;
    }
    .subtitle {
      margin-bottom: 3rem;
    }
  }
</style>
