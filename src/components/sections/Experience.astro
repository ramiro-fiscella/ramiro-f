---
import Section from '../Section.astro';
import { work } from '@cv';
---

<Section>
  <h2 class="subtitle">Experience</h2>
  <ul class="experience-list">
    {
      work.map(({ name, startDate, endDate, position, summary, url }) => {
        return (
          <li class="experience-item">
            <article class="experience-article">
              <header>
                <div>
                  <h3 class="company">{name}</h3>
                  <h4 class="position">{position}</h4>
                </div>
                <p class="date">
                  {startDate} - {endDate ? endDate : 'Present'}
                </p>
              </header>
              <p class="summary">{summary}</p>
              {url && (
                <a class="read-more" href={url} target="_blank">
                  View More
                </a>
              )}
            </article>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-content: flex-start;
    align-items: flex-start;
    margin-bottom: 4px;
  }
  .experience-list {
    /* columns: 3;
    column-width: 21rem; */
    /* column-rule: 1px solid rgba(255, 255, 255, 0.2); */
    /* column-gap: 1rem; */

    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0;
  }

  .experience-article {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 2rem 0;

    background: var(--color-fondo);
    color: var(--color-texto);

    /* border-radius: 8px; */
    transition: all 0.3s ease;
  }

  .experience-article:hover {
    background: var(--color-experiencia-fondo);
    /* border-color: var(--color-fondo); */
    /* box-shadow: 0px 4px 18px rgba(0, 0, 0, 0.164); */
  }

  .h3 {
    font-weight: 400;
    letter-spacing: 0.03rem;
    color: var(--color-texto);
  }

  .date {
    opacity: 0.75;
    font-size: 0.8rem;
    color: var(--color-terciario);
    text-transform: uppercase;
    letter-spacing: -0.01rem;
  }

  .position {
    margin-bottom: 0.4rem;
    font-weight: 400;
    text-transform: uppercase;
    color: var(--color-terciario);
  }

  .summary {
    opacity: 0.9;
  }

  .read-more::after {
    content: '↗';
    opacity: 0;
    transform: translateY(5px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .read-more:hover::after,
  .read-more:focus-visible::after {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.05s;
  }
  .read-more:hover,
  .read-more:focus-visible {
    transform: translateX(2px);
  }

  @media (max-width: 768px) {
    .experience-list {
      grid-template-columns: 1fr;
    }

    .experience-article {
      padding-inline: 0;
    }
    p.date {
      word-break: keep-all;
      white-space: nowrap;
    }
  }
</style>
