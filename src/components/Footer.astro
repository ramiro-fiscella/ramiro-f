---
// Importamos los 'basics' de tu CV
import { basics } from '@cv';

// Obtenemos el nombre (para el copyright) y los perfiles (para los enlaces)
const { name, profiles } = basics;

// Obtenemos el año actual para el copyright
const currentYear = new Date().getFullYear();
---

<footer>
  <hr />

  <div class="footer-container">
    <div class="copyright">
      <p>&copy; {currentYear} {name}</p>
    </div>

    {
      profiles && profiles.length > 0 && (
        <nav class="social-links">
          <ul>
            {profiles.map(({ network, url }) => (
              <li>
                <a
                  href={url}
                  title={`Visitar ${name} en ${network}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {network}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</footer>

<style>
  /* CSS MINIMALISTA 
    Eliminamos todo el CSS anterior (90vh, neumorfismo, etc.)
  */

  footer {
    /* Usamos tus variables de color existentes */
    background: var(--color-fondo);
    color: var(--color-texto);
    /* Un padding simple, mucho más pequeño que antes */
    padding: 2.5rem 1.5rem;
    width: 100%;
    margin-top: 4rem; /* Un poco de espacio arriba */
  }

  hr {
    /* Una línea sutil, como en la referencia */
    border: none;
    border-top: 1px solid var(--color-borde, #333); /* Usamos un color de borde si existe, si no, un gris */
    opacity: 0.5;
    margin-bottom: 2rem;
  }

  .footer-container {
    display: flex;
    justify-content: space-between; /* Copyright a la izq, links a la der */
    align-items: center;
    flex-wrap: wrap; /* Para que se apilen en móviles */
    gap: 1.5rem; /* Espacio entre elementos si se apilan */

    /* Centramos el contenido en un ancho máximo */
    max-width: 1200px;
    margin: 0 auto;
  }

  .copyright p {
    margin: 0; /* Quitamos margen por defecto */
    font-size: 0.9rem;
    color: var(
      --color-texto-secundario,
      var(--color-texto)
    ); /* Color más sutil si lo tienes */
    opacity: 0.8;
  }

  .social-links ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 1.5rem; /* Espacio entre los enlaces */
  }

  .social-links a {
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--color-texto);
    opacity: 0.8;
    transition:
      color 0.3s ease,
      opacity 0.3s ease;
  }

  .social-links a:hover {
    color: var(--color-primario); /* Usamos tu color primario para el hover */
    opacity: 1;
  }

  /* Media Query para móviles: apilamos los elementos */
  @media (max-width: 640px) {
    .footer-container {
      flex-direction: column;
      align-items: flex-start; /* Alineamos todo a la izquierda */
    }
  }
</style>
